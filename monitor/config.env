# aiops 数据平面配置 v1
# 所有值都可用同名环境变量覆盖（:= 只在未设置时赋值），
# 便于本地测试（monitor/test/run_local_test.sh）与服务器运行共用一套脚本。

# 被监控应用
: "${AIOPS_APP_NAME:=demo-app}"
: "${AIOPS_APP_ENV:=local}"            # local|dev|staging|prod

# 目录
: "${AIOPS_STATE_DIR:=/var/lib/aiops/state}"       # 内部状态: offset/签名/计数器/指标快照
: "${AIOPS_INCIDENT_DIR:=/var/lib/aiops/incidents}" # Incident 队列(契约 v1 JSON), Phase 3 agent 从这里消费
: "${AIOPS_APP_LOG:=/var/log/aiops/app.log}"        # 被监控应用日志文件

# 日志扫描
: "${AIOPS_DEDUP_WINDOW_SEC:=600}"     # 同一异常签名去抖窗口(秒)：窗口内只发一次 Incident
: "${AIOPS_MAX_EXCERPT_LINES:=10}"     # logExcerpt 最多包含行数(上下文裁剪, 控制后续 token 成本)

# 资源告警(仅在 AIOPS_WATCH_RESOURCES=true 时生效)
: "${AIOPS_WATCH_RESOURCES:=false}"    # 服务器上建议置 true
: "${AIOPS_CPU_WARN_PCT:=80}"          # CPU 使用率阈值 %
: "${AIOPS_MEM_WARN_PCT:=85}"          # 内存使用率阈值 %
: "${AIOPS_RESOURCE_CONSECUTIVE:=3}"   # 连续 N 次采样超阈值才告警(防抖)

# 指标采集
: "${AIOPS_COLLECT_METRICS:=true}"     # false 时跳过指标采集(受限环境/纯日志测试);
                                       # Incident.metrics 字段将输出 0, 生产 Linux 保持 true
